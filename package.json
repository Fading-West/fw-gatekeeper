{
  "name": "fw-gatekeeper",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "test:enrollment-lifecycle": "vitest run src/app/enroll/enrollment.test.tsx",
    "test": "vitest run && npm run test:python && npm run test:contracts",
    "start": "next start",
    "test:convex-auth": "vitest run convex/access.test.ts",
    "test:workers": "vitest run convex/workers.test.ts",
    "test:employee-directory": "vitest run src/lib/employee-directory.test.ts",
    "test:app-guides": "vitest run src/lib/app-guides.test.ts && node scripts/test-app-guides-contract.mjs",
    "test:kiosk-sync-auth": "python3 pi-kiosk/test_sync_auth.py",
    "test:kiosk-sync-mapping": "python3 pi-kiosk/test_sync_mapping.py && python3 pi-kiosk/test_worker_identity.py",
    "test:kiosk-ui-auth": "python3 pi-kiosk/test_kiosk_ui_auth.py",
    "test:face-service-auth": "python3 face-service/test_face_auth.py && node scripts/test-face-service-auth-contract.mjs",
    "test:login-error-copy": "node scripts/test-login-error-copy.mjs",
    "test:worker-ui": "node scripts/test-worker-ui-contract.mjs",
    "test:enrollment-permissions": "node scripts/test-enrollment-permissions-contract.mjs",
    "test:kiosk-readiness": "node scripts/test-kiosk-readiness-contract.mjs",
    "test:recognition-attempts": "node scripts/test-recognition-attempts-contract.mjs",
    "test:secured-ingest": "node scripts/test-secured-ingest-contract.mjs",
    "test:dashboard-partial-data": "node scripts/test-dashboard-partial-data-contract.mjs",
    "test:shift-exceptions": "node scripts/test-shift-exceptions-contract.mjs",
    "test:shift-briefing": "node scripts/test-shift-briefing-contract.mjs",
    "test:shift-closeout": "node scripts/test-shift-closeout-contract.mjs",
    "test:proactive-actions": "node scripts/test-proactive-actions-contract.mjs",
    "test:attendance-corrections": "node scripts/test-attendance-corrections-contract.mjs",
    "test:date": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-date-contract.mjs",
    "test:convex-local-date": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-convex-local-date-contract.mjs",
    "test:model-pinning": "python3 pi-kiosk/test_model_pinning.py && python3 face-service/test_model_pinning.py",
    "test:face-encode-quality": "python3 face-service/test_encode_quality.py",
    "test:python": "node scripts/run-python-tests.mjs",
    "test:contracts": "node scripts/run-contract-tests.mjs",
    "typecheck": "tsc --noEmit && tsc -p convex/tsconfig.json --noEmit",
    "test:workers-purge": "vitest run convex/workers.purge.test.ts",
    "test:shift-exceptions-behavior": "vitest run convex/shiftExceptions.test.ts",
    "test:kiosk-sync-batches": "python3 pi-kiosk/test_sync_batches.py",
    "test:kiosk-matching": "python3 pi-kiosk/test_matching.py"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.95",
    "convex": "^1.32.0",
    "next": "^16.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-test-renderer": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "convex-test": "^0.0.50",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "postcss": "^8.4.49",
    "react-test-renderer": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
