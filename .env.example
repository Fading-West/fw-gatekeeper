# FW Gatekeeper environment reference. Placeholder values only - never commit real secrets.
# Variables are grouped by WHERE they are set; the same name can appear in more than one place
# and those copies must be identical.

# ---------------------------------------------------------------------------
# 1. Render web service `fw-gatekeeper` (Next.js dashboard) - set in Render > Environment
#    (render.yaml declares these; `sync: false` ones are entered by hand)
# ---------------------------------------------------------------------------
# Build/runtime mode. Configure KIOSK_API_KEY in every environment.
NODE_ENV=production
# Node major used by Render; keep in sync with .node-version and package.json engines.
NODE_VERSION=22
# Convex deployment URL used by the browser and server Convex clients.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Convex HTTP-actions base URL (the .convex.site host) for secured ingest; derived from NEXT_PUBLIC_CONVEX_URL if unset.
CONVEX_INGEST_URL=https://your-deployment.convex.site
# Bearer secret for the secured ingest routes. MUST equal CONVEX_INGEST_KEY on the Convex deployment (section 2).
CONVEX_INGEST_KEY=replace-with-a-long-random-secret
# Shared secret every Pi kiosk presents on /api/sync and /api/attendance*. MUST equal KIOSK_API_KEY in each kiosk's config_local.py (section 4).
KIOSK_API_KEY=replace-with-a-long-random-secret
# Face service encode endpoint used during enrollment.
FACE_ENCODE_URL=https://fw-face-service.onrender.com/encode
# Secret sent as x-face-service-key. MUST equal FACE_SERVICE_KEY on the face service (section 3).
FACE_SERVICE_KEY=replace-with-a-long-random-secret
# Optional, dev only, default off: allow kiosk routes when KIOSK_API_KEY is unset (introduced in a sibling PR to src/lib/auth.ts). Never set in production.
# FW_ALLOW_UNCONFIGURED_KIOSK_KEY=true

# ---------------------------------------------------------------------------
# 2. Convex deployment - set with `npx convex env set NAME value` (or the Convex dashboard),
#    NOT on Render. Read by convex/http.ts and Convex Auth.
# ---------------------------------------------------------------------------
# Secured ingest secret checked by convex/http.ts. MUST equal CONVEX_INGEST_KEY on Render (section 1).
CONVEX_INGEST_KEY=replace-with-a-long-random-secret
# Convex Auth RS256 signing key; generated and set for you by `npx @convex-dev/auth` (PKCS8 PEM, newlines collapsed to spaces).
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY----- ... -----END PRIVATE KEY-----"
# Convex Auth public JSON Web Key Set matching JWT_PRIVATE_KEY; generated alongside it by `npx @convex-dev/auth`.
JWKS={"keys":[{"use":"sig","kty":"RSA","n":"...","e":"AQAB"}]}
# Public URL of the dashboard, used by Convex Auth for redirects; `npx @convex-dev/auth` prompts for it.
SITE_URL=https://fw-gatekeeper.onrender.com
# Dedicated activity-only bearer credential (32+ random characters). Set only
# on Convex; the Next.js source endpoint forwards the caller's bearer header.
ACTIVITY_FW_GATEWAY_TOKEN=replace-with-a-separate-long-random-secret
# Existing Convex `users` document ID for the approved source account. The
# account must remain an active Gateway admin; this is checked on every read.
ACTIVITY_FW_GATEWAY_ACCOUNT_ID=replace-with-an-existing-convex-user-id

# ---------------------------------------------------------------------------
# 3. Render web service `fw-face-service` (FastAPI, Docker) - set in Render > Environment
# ---------------------------------------------------------------------------
# Port uvicorn listens on (the Dockerfile exposes 5557).
PORT=5557
# Secret required in the x-face-service-key header on /encode and /match. MUST equal FACE_SERVICE_KEY on the dashboard (section 1).
FACE_SERVICE_KEY=replace-with-a-long-random-secret
# Comma-separated browser origins allowed by CORS; wildcards are rejected.
FACE_SERVICE_ALLOWED_ORIGINS=https://fw-gatekeeper.onrender.com

# ---------------------------------------------------------------------------
# 4. Kiosk `pi-kiosk/config_local.py` - written by `sudo ... bash pi-kiosk/setup.sh` from
#    these environment variables (the file is Python, not dotenv; it is gitignored)
# ---------------------------------------------------------------------------
# Dashboard base URL the kiosk syncs with.
SERVER_URL=https://fw-gatekeeper.onrender.com
# Unique identifier for this kiosk (must match the kiosk record in the dashboard).
KIOSK_ID=kiosk-entry-1
# `entry` or `exit`.
KIOSK_TYPE=entry
# Display name shown on the kiosk screen and dashboard.
KIOSK_NAME=Main Entry
# Shared server-sync secret. MUST equal KIOSK_API_KEY on the dashboard (section 1).
KIOSK_API_KEY=replace-with-a-long-random-secret
# Pi-local secret protecting camera, roster, attendance, and manual-clock routes (e.g. `openssl rand -hex 24`).
KIOSK_UI_KEY=replace-with-a-separate-local-secret
# Supervisor-only passcode for manual attendance controls.
KIOSK_SUPERVISOR_PIN=replace-with-your-supervisor-passcode

# Optional Convex kiosk alerts (see docs/alerting.md in the alerting PR):
# RESEND_API_KEY=replace-with-resend-key
# ALERT_EMAIL_FROM=alerts@example.com
# ALERT_EMAIL_TO=operations@example.com
# ALERT_WEBHOOK_URL=https://your-webhook.example/alerts

# Optional face-service enrollment quality settings (defaults shown):
# MIN_GOOD_PHOTOS=2
# MIN_PAIRWISE_SIMILARITY=0.6
# FACE_MODEL_DIR=/app/models
